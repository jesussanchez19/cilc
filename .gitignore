# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# leads — datos privados, no subir al repo
/data/leads.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — se versiona solo el grafo, para que cualquier sesión (incluidos
# agentes en la nube, sin la herramienta instalada) lo tenga sin regenerarlo.
# El resto es visualización, instantáneas y caché: pesa 1.2 MB, se reconstruye
# con `graphify extract` y manifest.json guarda mtime propios de cada máquina.
graphify-out/*
!graphify-out/graph.json
