# ── Resend (emails) ────────────────────────────────────────────────────────────
# Crea una cuenta en https://resend.com y genera un API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Analytics 4 ─────────────────────────────────────────────────────────
# ID de la propiedad GA4 (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── URL pública del sitio ──────────────────────────────────────────────────────
# Usada en sitemap.xml, robots.txt y metadataBase
NEXT_PUBLIC_SITE_URL=https://cilc.mx

# ── Google Search Console ──────────────────────────────────────────────────────
# Código de verificación obtenido en https://search.google.com/search-console
# (solo el valor del meta tag, sin comillas)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# Crea un proyecto en https://sanity.io y copia el Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Token de SOLO LECTURA (permiso Viewer). Obligatorio con el dataset privado:
# sin él las consultas anónimas fallan y el sitio se queda sin contenido.
# Sin prefijo NEXT_PUBLIC_ a propósito — así nunca llega al bundle del navegador.
SANITY_API_READ_TOKEN=

# Respaldo del correo de recuperación del Studio. La fuente de verdad es el
# campo "Email de seguridad" de Configuración del sitio en Sanity; esta variable
# solo se usa si ese campo está vacío.
STUDIO_RECOVERY_EMAIL=

# Logo de las plantillas de correo. Opcional: si se omite se usa el que está
# subido al CDN de Sanity. Debe ser una URL absoluta y accesible sin login —
# los servidores de Gmail/Outlook no alcanzan localhost.
EMAIL_LOGO_URL=

# ── Formulario de testimonio ───────────────────────────────────────────────────
# Token secreto para acceder al formulario privado /dar-testimonio?acceso=TOKEN
TESTIMONIAL_ACCESS_TOKEN=
