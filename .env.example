# ── Resend (emails) ────────────────────────────────────────────────────────────
# Crea una cuenta en https://resend.com y genera un API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Analytics 4 ─────────────────────────────────────────────────────────
# ID de la propiedad GA4 (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── URL pública del sitio ──────────────────────────────────────────────────────
# Usada en sitemap.xml, robots.txt y metadataBase
NEXT_PUBLIC_SITE_URL=https://cilc.mx

# ── Google Search Console ──────────────────────────────────────────────────────
# Código de verificación obtenido en https://search.google.com/search-console
# (solo el valor del meta tag, sin comillas)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# Crea un proyecto en https://sanity.io y copia el Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# ── Formulario de testimonio ───────────────────────────────────────────────────
# Token secreto para acceder al formulario privado /dar-testimonio?acceso=TOKEN
TESTIMONIAL_ACCESS_TOKEN=
