# ═══════════════════════════════════════════════════════════════════════════
#  Variables de entorno de CILC
#
#  Copia este archivo como `.env.local` y rellena los valores.
#  Las marcadas [OBLIGATORIA EN PRODUCCIÓN] hay que definirlas también en el
#  panel del hosting, o el sitio se despliega roto. Ver DESPLIEGUE.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── Resend (correo) ────────────────────────────────────────────────────────────
# [OBLIGATORIA] Crea una cuenta en https://resend.com y genera un API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# [OBLIGATORIA EN PRODUCCIÓN] Dominio verificado desde el que se envían los
# correos, por ejemplo `cilc.mx`.
#
# Si se deja vacío se usa `onboarding@resend.dev`, el dominio de pruebas de
# Resend, que SOLO entrega al correo con el que se registró la cuenta. Con él,
# ningún cliente recibe su confirmación de contacto o cotización: Resend
# responde 403. Verifica el dominio en https://resend.com/domains antes de
# desplegar.
EMAIL_FROM_DOMAIN=

# ── Google Analytics 4 ─────────────────────────────────────────────────────────
# ID de la propiedad GA4 (formato G-XXXXXXXXXX). Opcional.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── URL pública del sitio ──────────────────────────────────────────────────────
# [OBLIGATORIA EN PRODUCCIÓN] Se usa en sitemap.xml, robots.txt, metadataBase y
# las imágenes de Open Graph.
#
# Mientras no haya dominio propio, el valor es el subdominio de Vercel, que es
# la única dirección que de verdad sirve este sitio. NO pongas `cilc.mx`: ese
# dominio es de otra empresa que comparte las siglas, y apuntar ahí le
# atribuiría a un tercero el contenido en el sitemap y la etiqueta canónica.
NEXT_PUBLIC_SITE_URL=https://cilc.vercel.app

# ── Google Search Console ──────────────────────────────────────────────────────
# Código de verificación de https://search.google.com/search-console
# (solo el valor del meta tag, sin comillas). Opcional.
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# [OBLIGATORIAS] Project ID y dataset del proyecto en https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production

# [OBLIGATORIA] Token con permiso de escritura (Editor). Lo usan las rutas de
# servidor para guardar testimonios, tokens y la contraseña del Studio.
SANITY_API_WRITE_TOKEN=

# [OBLIGATORIA] Token de SOLO LECTURA (permiso Viewer). El dataset es privado:
# sin este token las consultas fallan y el sitio se queda SIN NADA de contenido.
# Sin prefijo NEXT_PUBLIC_ a propósito — así nunca llega al bundle del navegador.
SANITY_API_READ_TOKEN=

# Secreto del webhook de revalidación (/api/revalidate). Opcional: solo hace
# falta si configuras un webhook en Sanity para refrescar el contenido al
# publicar.
SANITY_WEBHOOK_SECRET=

# ── Acceso al Studio ───────────────────────────────────────────────────────────
# [OBLIGATORIA] Clave con la que se FIRMAN las cookies de sesión del Studio.
# Debe ser una cadena larga y aleatoria. Cambiarla invalida todas las sesiones
# abiertas de golpe, que es la forma de echar a todo el mundo si hace falta.
STUDIO_SESSION_TOKEN=

# Respaldo del correo de recuperación. La fuente de verdad es el campo
# "Email de seguridad" de Configuración del sitio en Sanity; esta variable solo
# se usa si ese campo está vacío.
STUDIO_RECOVERY_EMAIL=

# Logo de las plantillas de correo. Opcional: si se omite se usa el que está
# subido al CDN de Sanity. Debe ser una URL absoluta y accesible sin login —
# los servidores de Gmail/Outlook no alcanzan localhost.
EMAIL_LOGO_URL=

# ── Formulario de testimonio ───────────────────────────────────────────────────
# [OBLIGATORIA] Token maestro para /dar-testimonio?acceso=TOKEN y para generar
# los enlaces de un solo uso desde el panel de administración.
TESTIMONIAL_ACCESS_TOKEN=
